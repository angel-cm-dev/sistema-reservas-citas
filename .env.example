# Copia este archivo a .env y ajusta los valores. NUNCA subas tu .env real al repositorio.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambia_esta_clave

# --- Backend ---
# Local sin Docker se puede usar SQLite: sqlite:///./reservas.db
DATABASE_URL=postgresql+psycopg://reservas:cambia_esta_clave@localhost:5432/reservas
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TIMEZONE=America/Lima
SEED_ON_START=true

# Políticas de reserva
SLOT_STEP_MINUTES=15
MIN_ADVANCE_MINUTES=120
MAX_ADVANCE_DAYS=60
CANCELLATION_MIN_HOURS=24
MAX_RESCHEDULES=2

# Recordatorios (job programado)
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=5

# --- Frontend ---
VITE_API_URL=/api/v1
